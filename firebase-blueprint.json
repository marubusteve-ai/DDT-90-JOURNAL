        "plannedRiskAmount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "plannedRiskPct": { "type": "string", "pattern": "^\\d+(\\.\\d{1,4})?$", "maxLength": 16 },
        "actualRiskAmount": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "exitAt": { "type": "string", "maxLength": 40 },
        "exitPrice": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "exitQuantity": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "exitReason": { "type": "string", "maxLength": 500 },
        "manualGrossPnl": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "fxConversionRate": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "playbookId": { "type": "string", "maxLength": 128 },
        "setupId": { "type": "string", "maxLength": 128 },
        "setupTag": { "type": "string", "maxLength": 80 },
        "commission": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "swap": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "fees": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "slippage": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "spread": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$", "maxLength": 24 },
        "marketConditions": { "type": "array", "description": "Up to 16 market context tags." },
        "entryNotes": { "type": "string", "maxLength": 1000 },
        "reviewNotes": { "type": "string", "maxLength": 1500 },
        "tags": { "type": "array", "description": "Up to 10 trade tags." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "workspaceId", "accountId", "ownerId", "symbol", "direction", "status",
        "isArchived", "timeframes", "timezone", "accountCurrency", "marketConditions", "tags",
        "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile and UI/account preferences."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Top-level workspace owned by authenticated user."
    },
    "/workspaces/{workspaceId}/portfolios/{portfolioId}": {
      "schema": { "$ref": "#/entities/Portfolio" },
      "description": "Portfolio groupings scoped to parent workspace."
    },
    "/workspaces/{workspaceId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "Trading accounts scoped to parent workspace."
    },
    "/workspaces/{workspaceId}/cashTransactions/{transactionId}": {
      "schema": { "$ref": "#/entities/CashTransaction" },
      "description": "Cash movements (deposits, withdrawals, payouts, fees, adjustments) scoped to workspace and account."
    },
    "/workspaces/{workspaceId}/balanceSnapshots/{snapshotId}": {
      "schema": { "$ref": "#/entities/BalanceSnapshot" },
      "description": "Historical verified balance/equity snapshots and reconciliation checkpoints."
    },
    "/workspaces/{workspaceId}/brokers/{brokerId}": {
      "schema": { "$ref": "#/entities/Broker" },
      "description": "Workspace-scoped broker reference records."
    },
    "/workspaces/{workspaceId}/platforms/{platformId}": {
      "schema": { "$ref": "#/entities/TradingPlatform" },
      "description": "Workspace-scoped trading platform reference records."
    },
    "/workspaces/{workspaceId}/propFirms/{firmId}": {
      "schema": { "$ref": "#/entities/PropFirm" },
      "description": "Workspace-scoped proprietary firm reference records."
    },
    "/workspaces/{workspaceId}/fxRates/{rateId}": {
      "schema": { "$ref": "#/entities/FXRateSnapshot" },
      "description": "Workspace-scoped explicit FX rate snapshots for multi-currency rollups."
    },
    "/workspaces/{workspaceId}/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable append-only audit log entries for workspace activity."
    },
    "/workspaces/{workspaceId}/instruments/{instrumentId}": {
      "schema": { "$ref": "#/entities/InstrumentSpecification" },
      "description": "Workspace-scoped tradable instrument specifications."
    },
    "/workspaces/{workspaceId}/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Workspace- and account-scoped trade journal entries."
    }
  }
}
