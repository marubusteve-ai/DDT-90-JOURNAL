        "verifiedBalanceSnapshot": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,8})?$",
          "maxLength": 24
        },
        "verifiedEquitySnapshot": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,8})?$",
          "maxLength": 24
        },
        "snapshotAsOf": {
          "type": "string",
          "maxLength": 40
        },
        "reconciliationNotes": {
          "type": "string",
          "maxLength": 500
        },
        "openingDate": {
          "type": "string",
          "maxLength": 32
        },
        "challengePhase": {
          "type": "string",
          "maxLength": 40
        },
        "profitTargetAmount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$",
          "maxLength": 24
        },
        "profitTargetPct": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,4})?$",
          "maxLength": 16
        },
        "maxDailyLossAmount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$",
          "maxLength": 24
        },
        "maxDailyLossPct": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,4})?$",
          "maxLength": 16
        },
        "maxOverallLossAmount": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$",
          "maxLength": 24
        },
        "maxOverallLossPct": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,4})?$",
          "maxLength": 16
        },
        "drawdownMode": {
          "type": "string",
          "enum": ["none", "static", "trailing_eod", "trailing_intraday", "custom"],
          "maxLength": 24
        },
        "minTradingDays": {
          "type": "integer"
        },
        "maxTradingDays": {
          "type": "integer"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "tags": {
          "type": "array",
          "description": "Up to 10 account tags (each <= 40 chars)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerId",
        "name",
        "accountType",
        "status",
        "baseCurrency",
        "timezone",
        "startingBalance",
        "drawdownMode",
        "tags",
        "createdAt",
        "updatedAt"
      ]
    },
    "CashTransaction": {
