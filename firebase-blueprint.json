        },
        "propFirmId": {
          "type": "string",
          "maxLength": 128
        },
        "propFirmName": {
          "type": "string",
          "maxLength": 80
        },
        "platformId": {
          "type": "string",
          "maxLength": 128
        },
        "platformName": {
          "type": "string",
          "maxLength": 64
        },
        "baseCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 3
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        },
        "startingBalance": {
          "type": "string",
