{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and persisted terminal preferences (PII isolated to owner).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "maxLength": 320,
          "description": "Authenticated user email."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional user avatar URL."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "maxLength": 10,
          "description": "UI color theme preference."
        },
        "defaultCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 3,
          "description": "Preferred display currency code."
        },
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "description": "Preferred IANA timezone."
        },
        "activeWorkspaceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Last selected workspace ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "displayName", "theme", "defaultCurrency", "timezone", "createdAt", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Top-level trading workspace container owned by an authenticated user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "baseCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 3
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "ownerId", "name", "baseCurrency", "timezone", "status", "createdAt", "updatedAt"]
    },
